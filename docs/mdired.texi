@node Features
@chapter Features

@cindex Features

@table @asis
@item @code{mdired-copy}
copy a single file to multiple directories.

@item @code{mdired-do-command}
run an Elisp command on multiple files.

@item @code{mdired-compile}
run @code{compile} on multiple directories.

@item @code{mdired-byte-recompile}
byte-compile selected files or directories.
@end table

